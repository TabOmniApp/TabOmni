{
  "name": "tabula",
  "productName": "Tabula",
  "version": "0.0.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-electron.mjs --minify && vite build",
    "package": "bun run build && electron-builder",
    "test": "node scripts/test.mjs",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "//dependencies": "Only what the packaged app loads at runtime. Everything the renderer uses is bundled by Vite and everything the main process uses is bundled by esbuild, so it belongs below — these three are the esbuild externals, which stay real files in node_modules because node-pty loads a prebuilt binary and pg/mysql2 carry dynamic requires esbuild cannot resolve.",
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14",
    "mysql2": "^3.15.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@eslint/js": "^9",
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.1.7",
    "vite-svg-loader": "^5.1.1",
    "zustand": "^5.0.14"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20"
  },
  "//trustedDependencies": "bun does not run postinstall scripts unless a package is listed here; electron's is what downloads its binary.",
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "vn.app.tabula",
    "productName": "Tabula",
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*"
    ],
    "asarUnpack": [
      "dist-electron/daemon.cjs"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "notarize": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
