{
  "name": "tabomni",
  "productName": "TabOmni",
  "version": "1.0.15",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "//build": "Vite is run through node with an explicit heap size rather than through its bin shim: rolling up the renderer — mermaid, katex, Excalidraw, and a Lezer parser per language — peaks over 2GB, and V8 sizes the default old space from physical memory, so a 7GB machine (a macOS CI runner, a smaller laptop) caps it at ~2GB and the build dies with CALL_AND_RETRY_LAST while a 16GB one never notices.",
    "build": "node scripts/build-electron.mjs --minify && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "package": "bun run build && electron-builder",
    "test": "node scripts/test.mjs",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "//dependencies": "Only what the packaged app loads at runtime. Everything the renderer uses is bundled by Vite and everything the main process uses is bundled by esbuild, so it belongs below — these three are the esbuild externals, which stay real files in node_modules because node-pty loads a prebuilt binary and pg/mysql2 carry dynamic requires esbuild cannot resolve.",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@blocknote/core": "^0.53.0",
    "@blocknote/react": "^0.53.0",
    "@blocknote/shadcn": "^0.53.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@lydell/node-pty": "1.2.0-beta.14",
    "mysql2": "^3.15.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@eslint/js": "^9",
    "@excalidraw/excalidraw": "^0.18.1",
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@milkdown/react": "^7.22.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.1.7",
    "vite-svg-loader": "^5.1.1",
    "zustand": "^5.0.14"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20"
  },
  "//trustedDependencies": "bun does not run postinstall scripts unless a package is listed here; electron's is what downloads its binary.",
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "vn.app.tabomni",
    "productName": "TabOmni",
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*"
    ],
    "asarUnpack": [
      "dist-electron/daemon.cjs"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "notarize": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "//overrides": "One @codemirror/view for the whole renderer. Milkdown already depends on the CodeMirror packages and resolves them at 6.43.8, so the app's own direct dependency resolving one patch newer put two copies in node_modules — which is not merely wasteful: a CodeMirror extension is identified by the class it was built from, so a keymap from one copy is not a keymap to the other, and tsc says so before the editor does. Pinned exact, and the direct dependency is pinned to match.",
  "overrides": {
    "@codemirror/view": "6.43.8"
  }
}
